{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-os",
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learning-os",
      // Replace with your real Cloudflare D1 database UUID after creating it:
      "database_id": "5b08dc50-f92b-4e50-a3ad-e322a640a4dd",
      "migrations_dir": "src/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "learning-os-media"
    }
  ]
}
