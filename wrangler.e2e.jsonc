{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-os-e2e",
  "workers_dev": false,
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "learning-os",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "src/server/db/migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "learning-os-media" }],
  "vars": {
    "OWNER_EMAIL": "vaibhav@example.com",
    "APP_ORIGIN": "http://127.0.0.1:43124",
    "SESSION_PEPPER": "e2e-session-pepper",
    "ENVIRONMENT": "development",
    "E2E_AUTH_FIXTURE": "true"
  }
}
