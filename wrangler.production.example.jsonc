{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_WORKER_NAME",
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_D1_NAME",
    "database_id": "REPLACE_WITH_REAL_D1_ID",
    "migrations_dir": "src/server/db/migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "REPLACE_WITH_R2_BUCKET" }],
  "vars": {
    "ENVIRONMENT": "production",
    "OWNER_EMAIL": "REPLACE_WITH_OWNER_EMAIL",
    "APP_ORIGIN": "https://REPLACE_WITH_APP_DOMAIN",
    "GOOGLE_CLIENT_ID": "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_SECRET", "SESSION_PEPPER"]
  }
}
