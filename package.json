{
  "name": "learning-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 43123 --strictPort",
    "build": "pnpm content:check && tsc -b && vite build",
    "preview": "pnpm build && vite preview --port 43123 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.workers.config.ts",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "audit:architecture": "tsx scripts/architecture-audit.ts",
    "content:build": "tsx scripts/content-build.ts",
    "content:check": "tsx scripts/content-check.ts",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply learning-os --local --config wrangler.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "check": "pnpm content:check && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm audit:architecture && pnpm build"
  },
  "dependencies": {
    "@lexical/clipboard": "0.27.2",
    "@lexical/code": "0.27.2",
    "@lexical/history": "0.27.2",
    "@lexical/link": "0.27.2",
    "@lexical/list": "0.27.2",
    "@lexical/plain-text": "0.27.2",
    "@lexical/react": "0.27.2",
    "@lexical/rich-text": "0.27.2",
    "@lexical/selection": "0.27.2",
    "@lexical/utils": "0.27.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.44.5",
    "hono": "4.11.1",
    "lexical": "0.27.2",
    "lucide-react": "0.469.0",
    "react": "19.2.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wrangler": "4.136.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@esbuild/linux-x64"
    ]
  }
}
